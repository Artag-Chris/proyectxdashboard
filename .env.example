# ============================================================================
# dashboard (front de atiende + pestañas CV Harness y Social Coach) — copiá a .env.local
#
# - NEXT_PUBLIC_API_URL: backend de atiende. En el server usá la URL pública
#   (ej. https://atiende.lumenxlabs.com.co). Vacío = usa los rewrites de Next
#   (/{proxy}) y las llamadas quedan same-origin (evita CORS).
# - NEXT_PUBLIC_CV_API_URL: API de CV-Harness que ve el NAVEGADOR (CORS abierto
#   en el harness). Debe ser HTTPS si el dashboard se sirve por HTTPS
#   (Vercel): el navegador bloquea http:// desde una página https://
#   (mixed content) y la pestaña CV aparece vacía.
#   NO pongas localhost si vas a abrir el dashboard desde otra máquina.
# - NEXT_PUBLIC_SOCIAL_API_URL: API de Social-Harness, con la MISMA regla que la
#   de CV (la ve el navegador, así que tiene que ser https:// en producción).
# ============================================================================
NEXT_PUBLIC_API_URL=https://atiende.lumenxlabs.com.co
# NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_CV_API_URL=https://cv-harness.artagdev.com.co/api
# Dev local (dashboard y harness en la misma máquina):
# NEXT_PUBLIC_CV_API_URL=http://localhost:3100/api

NEXT_PUBLIC_SOCIAL_API_URL=https://social-harness.lumenxlabs.com.co/api
# Dev local (el harness corre en la misma máquina):
# NEXT_PUBLIC_SOCIAL_API_URL=http://localhost:3200/api

# - NEXT_PUBLIC_DOCS_API_URL: API de Doc-Harness (pestaña "Documentos"), con la
#   MISMA regla que CV/Social (la ve el navegador → https:// en producción).
NEXT_PUBLIC_DOCS_API_URL=https://<tu-dominio-del-harness>/api
# Dev local:
# NEXT_PUBLIC_DOCS_API_URL=http://localhost:3300/api
#
# OJO: las NEXT_PUBLIC_* se incrustan en el BUILD. Si cambiás el valor en Vercel,
# hay que REDESPLEGAR (sin eso, el sitio sigue con el valor viejo compilado).
#
# Verificá que esta URL sea la correcta con:
#   curl -s https://social-harness.lumenxlabs.com.co/api/health
# Tiene que devolver {"status":"ok","db":"up",...}. Si tu proxy sirve la API en la
# raíz (sin /api), quitá el /api final.
